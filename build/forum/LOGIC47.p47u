  XEQ 01                        ; -> :PAGE:
  RCL 23
  62
  X=Y?
  XEQ 02                        ; -> :DEL:
  RCL 23
  63
  X=Y?
  XEQ 07                        ; -> :EVAL:
  RCL 23
  52
  X=Y?
  XEQ 03                        ; -> :CLEAR:
  RCL 23
  64
  X=Y?
  XEQ 36                        ; -> :TABLE:
ENDDO 01
