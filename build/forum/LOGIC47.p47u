LBL 79                          ; glyph of code 5 (letter f): u
"u"
RTN
LBL 80                          ; glyph of code 6 (letter g): true (drawn T)
@ true drawn as a plain T: the font's ⊤ is the small raised transpose T
"T"
RTN
LBL 81                          ; glyph of code 7 (letter h): false
"⊥"
RTN
LBL 82                          ; glyph of code 8 (letter i): not
"¬"
RTN
LBL 83                          ; glyph of code 9 (letter j): and
"∧"
RTN
LBL 84                          ; glyph of code 10 (letter k): or
"∨"
RTN
LBL 85                          ; glyph of code 11 (letter l): exclusive or (drawn ⊻)
@ exclusive or drawn as ⊻ (on the line as ∨): the font's ⊕ sits low, rows 10-20 of the cell
"⊻"
RTN
LBL 86                          ; glyph of code 12 (letter m): implies
"→"
RTN
LBL 87                          ; glyph of code 13 (letter n): if and only if
"↔"
RTN
LBL 88                          ; glyph of code 14 (letter o): (
"("
RTN
LBL 89                          ; glyph of code 15 (letter p): )
")"
RTN
